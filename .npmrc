# 1. Enable Shameful Hoisting
# Flattens dependencies so Vite finds "react" in the root.
shamefully-hoist=true

# 2. Aggressively ban DB drivers from the root
# Forces "better-sqlite3" to exist only in nested folders, allowing
# dual-compilation (Node vs Electron) without overwriting.
public-hoist-pattern[]=*
public-hoist-pattern[]=!better-sqlite3
public-hoist-pattern[]=!drizzle-kit